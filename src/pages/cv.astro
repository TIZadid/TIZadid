---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getSite } from '../lib/site';
import { buildCv } from '../lib/cv/build';
import type { CvEntry } from '../lib/cv/model';

const site = await getSite();
const cv = buildCv(site);
const entryGroups: [string, string, CvEntry[]][] = [
  ['experience', 'Work experience', cv.experience],
  ['projects', 'Projects', cv.projects],
  ['education', 'Education', cv.education],
];
---
<Base title={`CV — ${cv.name}`} description={`The CV of ${cv.name}, as a PDF or plain text.`}>
  <section class="page wrap" data-cv>
    <header class="head" data-lines>
      <p class="label"><span class="accent">CV</span> / {cv.name}</p>
      <h1 class="display title">
        <span class="mask"><span>Curriculum <span class="accent">vitae.</span></span></span>
      </h1>
      <p class="lede" data-reveal>
        Take it as it is, or untick what you don't need and add a note of your own.
        The PDF is plain single-column text, so tracking systems can read it.
      </p>
    </header>

    <div class="cols">
      <form class="picker" data-reveal>
        <fieldset>
          <legend class="label">Header</legend>
          {cv.contacts.map((c) => (
            <label class="opt"><input type="checkbox" checked data-group="contacts" value={c.id} /><span>{c.label}<em>{c.value}</em></span></label>
          ))}
        </fieldset>

        <fieldset>
          <legend class="label">Sections</legend>
          <label class="opt"><input type="checkbox" checked data-group="flag" value="summary" /><span>Summary</span></label>
          <label class="opt"><input type="checkbox" checked data-group="flag" value="skills" /><span>Technical skills</span></label>
          <label class="opt"><input type="checkbox" checked data-group="flag" value="soft" /><span>Soft skills</span></label>
        </fieldset>

        {entryGroups.filter(([, , list]) => list.length).map(([group, title, list]) => (
          <fieldset>
            <legend class="label">{title}</legend>
            {list.map((entry) => (
              <div class="entry">
                <label class="opt opt--entry">
                  <input type="checkbox" checked data-group={group} value={entry.id} />
                  <span>{entry.heading}<em>{[entry.sub, entry.dates].filter(Boolean).join(' · ')}</em></span>
                </label>
                {entry.bullets.length > 0 && (
                  <div class="bullets">
                    {entry.bullets.map((bullet, i) => (
                      <label class="opt opt--bullet"><input type="checkbox" checked data-group="bullet" data-entry={entry.id} value={i} /><span>{bullet}</span></label>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </fieldset>
        ))}

        <fieldset>
          <legend class="label">Add text</legend>
          <label class="field"><span class="label">Heading</span>
            <input type="text" data-extra-title placeholder="e.g. Certifications" maxlength="60" />
          </label>
          <label class="field"><span class="label">Text, one line per row</span>
            <textarea data-extra-body rows="4" placeholder="Anything you want printed at the end of the CV"></textarea>
          </label>
        </fieldset>

        <div class="tools">
          <button type="button" class="label tool" data-all>Select all</button>
          <button type="button" class="label tool" data-none>Clear</button>
        </div>
      </form>

      <div class="out" data-reveal>
        <div class="bar">
          <p class="label"><span data-pages>A4</span> · live preview</p>
          <div class="actions">
            <button type="button" class="btn" data-copy-text><Icon name="copy" size={14} /><span data-copy-label>Copy text</span></button>
            <button type="button" class="btn" data-download-text><Icon name="file-text" size={14} />.txt</button>
            <button type="button" class="btn btn--solid" data-download><Icon name="download" size={14} />PDF</button>
          </div>
        </div>
        <article class="paper" data-preview data-lenis-prevent aria-label="CV preview">
          <noscript>The CV builder needs JavaScript to generate the PDF.</noscript>
        </article>
      </div>
    </div>
    <script type="application/json" id="cv-data" set:html={JSON.stringify(cv).replace(/</g, '\\u003c')} />
  </section>
</Base>

<script>
  import { applySelection, type Selection } from '../lib/cv/select';
  import { usableExtras, type CvEntry, type CvModel } from '../lib/cv/model';
  import { renderCvText } from '../lib/cv/text';

  const STORE = 'tiz-cv-unticked';
  const STORE_EXTRA = 'tiz-cv-extra';
  const esc = (text: string) => text.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  function setup() {
    const root = document.querySelector<HTMLElement>('[data-cv]');
    const data = document.getElementById('cv-data');
    if (!root || !data) return;
    const cv = JSON.parse(data.textContent ?? '{}') as CvModel;
    const preview = root.querySelector<HTMLElement>('[data-preview]')!;
    const boxes = Array.from(root.querySelectorAll<HTMLInputElement>('input[type=checkbox]'));
    const key = (box: HTMLInputElement) => `${box.dataset.group}:${box.dataset.entry ?? ''}:${box.value}`;

    // Remember what was unticked, so content added later starts ticked.
    try {
      const off: string[] = JSON.parse(localStorage.getItem(STORE) ?? '[]');
      for (const box of boxes) if (off.includes(key(box))) box.checked = false;
    } catch { /* storage unavailable */ }

    const read = (): Selection => {
      const on = (group: string) => boxes.filter((b) => b.dataset.group === group && b.checked);
      const flags = on('flag').map((b) => b.value);
      const bullets: Record<string, number[]> = {};
      for (const b of boxes.filter((b) => b.dataset.group === 'bullet')) {
        const list = (bullets[b.dataset.entry!] ??= []);
        if (b.checked) list.push(Number(b.value));
      }
      return {
        contacts: on('contacts').map((b) => b.value),
        summary: flags.includes('summary'), skills: flags.includes('skills'), soft: flags.includes('soft'),
        experience: on('experience').map((b) => b.value),
        projects: on('projects').map((b) => b.value),
        education: on('education').map((b) => b.value),
        bullets,
      };
    };

    const section = (title: string, inner: string) => (inner ? `<h3>${title}</h3>${inner}` : '');
    const entries = (list: CvEntry[]) =>
      list.map((e) => `<div class="e"><strong>${esc(e.heading)}</strong>
        <p>${esc([e.sub, e.dates].filter(Boolean).join(' | '))}</p>
        ${e.blurb ? `<p>${esc(e.blurb)}</p>` : ''}
        ${e.bullets.length ? `<ul>${e.bullets.map((b) => `<li>${esc(b)}</li>`).join('')}</ul>` : ''}</div>`).join('');

    const extraTitle = root.querySelector<HTMLInputElement>('[data-extra-title]')!;
    const extraBody = root.querySelector<HTMLTextAreaElement>('[data-extra-body]')!;
    try {
      const saved = JSON.parse(localStorage.getItem(STORE_EXTRA) ?? '{}');
      extraTitle.value = saved.title ?? '';
      extraBody.value = saved.body ?? '';
    } catch { /* storage unavailable */ }

    const current = (): CvModel => ({
      ...applySelection(cv, read()),
      extra: [{ title: extraTitle.value, lines: extraBody.value.split('\n') }],
    });
    const fileName = (ext: string) => `${cv.name.trim().replace(/\s+/g, '-')}-CV.${ext}`;

    const draw = () => {
      const m = current();
      const skills = [
        ...m.skills.map((g) => `<p>${esc(g.label)}: ${esc(g.items.join(', '))}</p>`),
        m.soft.length ? `<p>Soft skills: ${esc(m.soft.join(', '))}</p>` : '',
      ].join('');
      preview.innerHTML = `<h2>${esc(m.name)}</h2><p class="t">${esc(m.title)}</p>
        <p class="c">${esc(m.contacts.map((c) => c.value).join(' | '))}</p>
        ${section('SUMMARY', m.summary ? `<p>${esc(m.summary)}</p>` : '')}
        ${section('SKILLS', skills)}
        ${section('WORK EXPERIENCE', entries(m.experience))}
        ${section('PROJECTS', entries(m.projects))}
        ${section('EDUCATION', entries(m.education))}
        ${usableExtras(m).map((x) => section(esc(x.title), x.lines.map((l) => `<p>${esc(l)}</p>`).join(''))).join('')}`;
      for (const entry of root.querySelectorAll<HTMLElement>('.entry')) {
        entry.classList.toggle('is-off', !entry.querySelector<HTMLInputElement>('.opt--entry input')!.checked);
      }
      try {
        localStorage.setItem(STORE, JSON.stringify(boxes.filter((b) => !b.checked).map(key)));
        localStorage.setItem(STORE_EXTRA, JSON.stringify({ title: extraTitle.value, body: extraBody.value }));
      } catch { /* ignore */ }
    };

    root.addEventListener('change', draw);
    root.addEventListener('input', draw);
    // Untick-all keeps at least the name; it never touches the text the visitor typed.
    const setAll = (value: boolean) => { boxes.forEach((b) => (b.checked = value)); draw(); };

    const copyLabel = root.querySelector<HTMLElement>('[data-copy-label]')!;
    root.querySelector('[data-copy-text]')?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(renderCvText(current()));
        copyLabel.textContent = 'Copied';
      } catch {
        copyLabel.textContent = 'Copy failed';
      }
      window.setTimeout(() => (copyLabel.textContent = 'Copy text'), 2000);
    });
    root.querySelector('[data-download-text]')?.addEventListener('click', () => {
      const link = document.createElement('a');
      link.href = URL.createObjectURL(new Blob([renderCvText(current())], { type: 'text/plain;charset=utf-8' }));
      link.download = fileName('txt');
      link.click();
      URL.revokeObjectURL(link.href);
    });
    root.querySelector('[data-all]')?.addEventListener('click', () => setAll(true));
    root.querySelector('[data-none]')?.addEventListener('click', () => setAll(false));

    const button = root.querySelector<HTMLButtonElement>('[data-download]')!;
    button.addEventListener('click', async () => {
      button.disabled = true;
      try {
        const { renderCvPdf } = await import('../lib/cv/pdf');
        renderCvPdf(current()).save(fileName('pdf'));
      } finally {
        button.disabled = false;
      }
    });

    draw();
  }

  document.addEventListener('astro:page-load', setup);
</script>

<style>
  .page { padding-top: 120px; padding-bottom: var(--section); }
  .head { display: grid; gap: 20px; margin-bottom: clamp(40px, 6vw, 80px); }
  .title { font-size: clamp(2.8rem, 9vw, 8rem); }
  .lede { max-width: 52ch; color: var(--muted); }
  .cols { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: clamp(24px, 4vw, 64px); align-items: start; }

  fieldset { border: 0; border-top: 1px solid var(--line); margin: 0; padding: 18px 0 26px; display: grid; gap: 4px; }
  legend { padding: 0 12px 0 0; color: var(--accent); }
  .opt { display: grid; grid-template-columns: 18px 1fr; gap: 12px; align-items: start; padding: 8px 0; cursor: pointer; line-height: 1.35; }
  .opt em { display: block; font-style: normal; font-family: var(--mono); font-size: 0.75rem; color: var(--muted); margin-top: 2px; word-break: break-word; }
  .opt--entry { font-weight: 600; }
  .opt--bullet { font-size: 0.9rem; color: var(--muted); padding-block: 5px; }
  .bullets { padding-left: 30px; margin-bottom: 10px; transition: opacity 0.3s; }
  .entry.is-off .bullets { opacity: 0.35; pointer-events: none; }
  input[type='checkbox'] {
    appearance: none; width: 18px; height: 18px; margin: 2px 0 0; border: 1px solid var(--muted); background: transparent;
    display: grid; place-items: center; cursor: pointer; transition: background 0.2s, border-color 0.2s;
  }
  input[type='checkbox']::after { content: ''; width: 8px; height: 8px; background: var(--ink); transform: scale(0); transition: transform 0.25s var(--ease); }
  input[type='checkbox']:checked { background: var(--accent); border-color: var(--accent); }
  input[type='checkbox']:checked::after { transform: scale(1); }
  .field { display: grid; gap: 8px; padding-block: 8px; }
  .field input, .field textarea {
    font: inherit; color: var(--text); background: var(--surface); border: 1px solid var(--line);
    padding: 12px 14px; width: 100%; resize: vertical; border-radius: 0;
  }
  .field input:focus, .field textarea:focus { outline: none; border-color: var(--accent); }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .actions .btn { padding: 12px 14px; }
  .tools { display: flex; gap: 24px; border-top: 1px solid var(--line); padding-top: 18px; }
  .tool { color: var(--text); padding-block: 8px; }
  .tool:hover { color: var(--accent); }

  .out { position: sticky; top: 24px; display: grid; gap: 14px; }
  .bar { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
  .bar :global(.btn svg) { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .paper {
    background: #fbfaf7; color: #111; font-family: Helvetica, Arial, sans-serif; font-size: 0.78rem; line-height: 1.4;
    padding: clamp(20px, 3vw, 40px); max-height: calc(100svh - 120px); overflow: auto;
    box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.8);
  }
  .paper :global(h2) { font-size: 1.5rem; line-height: 1.2; }
  .paper :global(.t) { font-size: 0.9rem; }
  .paper :global(.c) { color: #333; }
  .paper :global(h3) { font-size: 0.8rem; margin: 18px 0 8px; padding-bottom: 3px; border-bottom: 1px solid #111; letter-spacing: 0.02em; }
  .paper :global(.e) { margin-bottom: 12px; }
  .paper :global(ul) { list-style: none; padding-left: 10px; }
  .paper :global(li)::before { content: '- '; }

  @media (max-width: 900px) {
    .cols { grid-template-columns: 1fr; }
    .out { position: static; grid-row: 1; }
    .paper { max-height: 60svh; }
    .bar { position: sticky; top: 0; z-index: 5; background: var(--bg); padding-block: 10px; }
  }
</style>
