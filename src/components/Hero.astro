---
import Icon from './Icon.astro';
import { getSite } from '../lib/site';
const { profile } = await getSite();
const p = profile.data;
const words = p.name.split(' ');
---
<section class="hero wrap" data-glow>
  <div class="meta" data-reveal>
    <p class="label">{p.title}</p>
    <p class="label loc"><Icon name="map-pin" size={12} />{p.location}</p>
    <p class="label">Portfolio / {new Date().getFullYear()}</p>
  </div>

  <h1 class="display name" data-lines data-hero aria-label={p.name}>
    {words.map((word, i) => (
      <span class="mask" aria-hidden="true">
        <span class:list={{ accent: i === words.length - 1 }}>{word}{i === words.length - 1 && '.'}</span>
      </span>
    ))}
  </h1>

  <div class="hud" aria-hidden="true" data-parallax="0.35">
    <svg class="cross" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1">
      <circle cx="60" cy="60" r="34" /><circle cx="60" cy="60" r="18" />
      <path d="M60 0v44M60 76v44M0 60h44M76 60h44" />
    </svg>
    <span class="label">TIZ—001</span>
    <span class="barcode"></span>
  </div>

  <div class="foot" data-reveal>
    <p class="tagline">{p.tagline}</p>
    <a class="btn" href="/cv" data-magnetic><Icon name="download" size={14} />Build my CV</a>
    <a class="label scroll" href="#profile">Scroll <Icon name="arrow-down" size={12} /></a>
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
    display: grid; grid-template-rows: auto 1fr auto; gap: 24px;
    padding-top: 104px; padding-bottom: 32px;
    position: relative; isolation: isolate;
  }
  .hero::before {
    content: ''; position: fixed; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(520px circle at var(--mx, 70%) var(--my, 30%), rgb(255 77 20 / 0.13), transparent 70%);
  }
  .meta { display: flex; flex-wrap: wrap; gap: 8px 40px; justify-content: space-between; border-top: 1px solid var(--line); padding-top: 14px; }
  .loc { display: inline-flex; gap: 6px; align-items: center; }
  .name { align-self: center; font-size: min(24vw, 24svh); font-weight: 900; }
  .hud {
    position: absolute; right: var(--gutter); top: 30%;
    display: grid; gap: 12px; justify-items: end; color: var(--muted);
  }
  .cross { width: clamp(72px, 10vw, 140px); color: var(--accent); animation: spin 40s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .foot { display: flex; flex-wrap: wrap; align-items: end; gap: 20px 40px; border-top: 1px solid var(--line); padding-top: 18px; }
  .tagline { max-width: 34ch; font-size: clamp(1.05rem, 1.6vw, 1.4rem); line-height: 1.3; margin-right: auto; }
  .scroll { display: inline-flex; gap: 8px; align-items: center; padding-block: 14px; }
  @media (max-width: 760px) {
    .hud { top: 150px; }
    .hud .label, .hud .barcode { display: none; }
    .scroll { display: none; }
  }
</style>
