---
import lucide from '@iconify-json/lucide/icons.json';
import simple from '@iconify-json/simple-icons/icons.json';

interface Props { name: string; size?: number }
const { name, size = 18 } = Astro.props;
// "si:strava" reads from Simple Icons (brands); anything else from Lucide.
const brand = name.startsWith('si:');
const key = brand ? name.slice(3) : name;
const icons = (brand ? simple : lucide).icons as Record<string, { body: string }>;
const body = (icons[key] ?? lucide.icons.plus).body;
---
<svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" set:html={body} />
