---
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { getSite } from '../lib/site';
import { parseBullets } from '../lib/cv/model';
const { experience } = await getSite();
const span = (a: string, b: string) => (a === b ? a : `${a} — ${b}`);
---
<section class="section wrap" id="work">
  <SectionHead index="02" label="Work" title="Experience" />
  <div class="list">
    {experience.map((job, i) => (
      <details class="job" name="job" open={i === 0} data-reveal>
        <summary>
          <span class="label dates">{span(job.data.start, job.data.end)}</span>
          <span class="display company">{job.data.short ?? job.data.company}</span>
          <span class="role">{job.data.role}{job.data.location && <span class="label"> / {job.data.location}</span>}</span>
          <span class="plus"><Icon name="plus" size={22} /></span>
        </summary>
        <div class="body">
          <div class="inner">
            {job.data.short && <p class="label">{job.data.company}</p>}
            {job.data.blurb && <p class="blurb">{job.data.blurb}</p>}
            <ul class="bullets">
              {parseBullets(job.body ?? '').map((bullet) => <li>{bullet}</li>)}
            </ul>
          </div>
        </div>
      </details>
    ))}
  </div>
</section>

<style>
  .list { border-bottom: 1px solid var(--line); }
  .job { border-top: 1px solid var(--line); }
  summary {
    display: grid; grid-template-columns: 14ch 1fr auto 32px; gap: 12px 32px; align-items: center;
    padding-block: clamp(20px, 3vw, 40px); cursor: pointer; list-style: none;
    transition: color 0.4s var(--ease), padding 0.5s var(--ease);
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover, .job[open] summary { color: var(--accent); }
  summary:hover { padding-left: 14px; }
  .company { font-size: clamp(2rem, 6vw, 5.5rem); }
  .role { color: var(--text); text-align: right; }
  .plus { transition: transform 0.5s var(--ease); }
  .job[open] .plus { transform: rotate(45deg); }

  .job::details-content { block-size: 0; overflow: clip; transition: block-size 0.6s var(--ease), content-visibility 0.6s allow-discrete; }
  .job[open]::details-content { block-size: auto; }
  .inner { display: grid; gap: 18px; padding: 0 0 clamp(28px, 4vw, 56px) calc(14ch + 32px); max-width: 1100px; }
  .blurb { font-size: clamp(1.1rem, 1.7vw, 1.5rem); line-height: 1.3; }
  .bullets { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 10px 40px; color: var(--muted); }
  .bullets li { padding-left: 18px; position: relative; }
  .bullets li::before { content: ''; position: absolute; left: 0; top: 0.65em; width: 8px; height: 1px; background: var(--accent); }

  @media (max-width: 760px) {
    summary { grid-template-columns: 1fr 32px; }
    .dates, .company, .role { grid-column: 1; }
    .role { text-align: left; }
    .plus { grid-column: 2; grid-row: 1 / span 3; }
    .inner { padding-left: 0; }
  }
</style>
